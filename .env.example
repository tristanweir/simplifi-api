# Optional environment settings. Sign in with `simplifi browser-login`.
# Do not store passwords or tokens in this file; .env files are not loaded automatically.
# Optional override; otherwise discovered via GET /datasets
SIMPLIFI_DATASET_ID=
# Optional ThreatMetrix session id captured from a real browser session
SIMPLIFI_THREAT_METRIX_SESSION_ID=
# Encrypted Windows DPAPI token cache (default: .local/tokens.dpapi in the package root)
SIMPLIFI_TOKEN_PATH=
# Optional interpreter override for run.ps1 (default: .venv/Scripts/python.exe)
SIMPLIFI_PYTHON=
