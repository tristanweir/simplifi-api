# Copy to .env or export in your shell. Prefer `simplifi login` over storing a password.
SIMPLIFI_EMAIL=
SIMPLIFI_PASSWORD=
# Optional override; otherwise discovered via GET /datasets
SIMPLIFI_DATASET_ID=
# Optional ThreatMetrix session id captured from a real browser session
SIMPLIFI_THREAT_METRIX_SESSION_ID=
# Where tokens are stored (default: ~/.simplifi/tokens.json)
SIMPLIFI_TOKEN_PATH=
